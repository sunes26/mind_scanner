# Spanlens API Key (필수) - OpenAI 프록시로 사용
SPANLENS_API_KEY=sps_your-spanlens-key-here

# Kakao JavaScript Key (선택)
NEXT_PUBLIC_KAKAO_APP_KEY=your-kakao-app-key

# Google Analytics (선택)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# 광고: 쿠팡 파트너스 다이나믹 배너 사용
# ID/트래킹코드는 components/ads/CoupangBanner.tsx에 상수로 정의됨 (환경변수 불필요)
