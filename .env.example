# Spanlens API Key (필수) - OpenAI 프록시로 사용
# https://www.spanlens.io/projects 에서 발급 (sps_... 형식)
SPANLENS_API_KEY=sps_your-spanlens-key-here

# Kakao JavaScript Key (선택)
# https://developers.kakao.com/ 에서 앱 생성 후 발급
NEXT_PUBLIC_KAKAO_APP_KEY=your-kakao-app-key

# Google Analytics (선택)
# https://analytics.google.com/ 에서 측정 ID 발급
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Google AdSense (선택)
# https://www.google.com/adsense/ 에서 발급
# 게시자 ID 형식: ca-pub-0000000000000000
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-XXXXXXXXXXXXXXXX

# 기본(레거시) 슬롯 - 위치별 슬롯이 설정되지 않은 경우 fallback으로 사용됨
NEXT_PUBLIC_ADSENSE_SLOT_RESULT=

# === 위치별 광고 슬롯 ===
# AdSense 콘솔 → 광고 → 광고 단위 기준 에서 위치별로 광고 단위를 개별 생성하고
# 10자리 슬롯 ID를 아래 변수에 채워넣으면, 리포트에서 위치별 수익을 분리 측정 가능.
# 비워두면 위 NEXT_PUBLIC_ADSENSE_SLOT_RESULT 값이 사용됨.

# 홈 화면 (/)
NEXT_PUBLIC_ADSENSE_SLOT_HOME_HERO=
NEXT_PUBLIC_ADSENSE_SLOT_HOME_FAQ=

# 분석 결과 화면 (/ 의 result state)
NEXT_PUBLIC_ADSENSE_SLOT_RESULT_INTEREST=
NEXT_PUBLIC_ADSENSE_SLOT_RESULT_REPLY=
NEXT_PUBLIC_ADSENSE_SLOT_RESULT_SECRET=
NEXT_PUBLIC_ADSENSE_SLOT_RESULT_FOOTER=

# 블로그 목록 (/blog)
NEXT_PUBLIC_ADSENSE_SLOT_BLOG_LIST_HERO=
NEXT_PUBLIC_ADSENSE_SLOT_BLOG_LIST_FEED=

# 블로그 글 (/blog/[slug])
NEXT_PUBLIC_ADSENSE_SLOT_BLOG_POST_TOP=
NEXT_PUBLIC_ADSENSE_SLOT_BLOG_POST_BODY=
NEXT_PUBLIC_ADSENSE_SLOT_BLOG_POST_CTA=
NEXT_PUBLIC_ADSENSE_SLOT_BLOG_POST_FOOTER=

# 법적 고지 (/privacy, /terms)
NEXT_PUBLIC_ADSENSE_SLOT_PRIVACY=
NEXT_PUBLIC_ADSENSE_SLOT_TERMS=
